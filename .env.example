# Numeric Telegram user ID allowed to reach Bud.
TELEGRAM_OWNER_ID=

# Secrets: configure real values locally or in the deployment environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Default Write Calendar and timezone authority. Event creation will use this Calendar.
GOOGLE_CALENDAR_ID=primary

# Optional comma-separated Read Set (maximum 10). Defaults to GOOGLE_CALENDAR_ID.
GOOGLE_CALENDAR_READ_IDS=primary

# One personal Google account authenticated with an offline OAuth grant.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional identity and AI Gateway model overrides.
BUD_ASSISTANT_NAME=Bud
BUD_MODEL_ID=openai/gpt-5.4-mini
